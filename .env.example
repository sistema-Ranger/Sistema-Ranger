# --- PostgreSQL ---
POSTGRES_USER=ranger
POSTGRES_PASSWORD=ranger_dev
POSTGRES_DB=ranger
POSTGRES_PORT=5432

# --- Puertos ---
BACKEND_PORT=8000
FRONTEND_PORT=5173

# --- Backend ---
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
JWT_SECRET=change_me_dev_only
JWT_EXPIRE_MINUTES=480
COLLECTOR_API_KEY=dev_collector_key
ADMIN_EMAIL=admin@ranger.local
ADMIN_PASSWORD=admin123

# --- Worker / ML ---
ANALYSIS_INTERVAL_SECONDS=60
MODEL_DIR=/code/ml/models
ALERT_COOLDOWN_MINUTES=15

# --- Recolector ---
COLLECT_INTERVAL=10
COLLECTOR_HOSTNAME=dev-container
# normal | cpu_spike | memory_leak | disk_fill | error_burst | degradation
COLLECTOR_SCENARIO=normal
